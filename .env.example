CONVERSATION_LINKS=
DEMO_BASE=
DEMO_PORT=
DEMO_ROOM=
FIREBASE_API_KEY=
FIRESTORE_COLLECTION=
FIRESTORE_DATABASE_ID=
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Transport selection for the results board.
#   unset / demo  -> in-memory DemoTransport seed (default, no network)
#   firestore     -> FirestoreTransport, the shared public Firestore collection
TRANSPORT=demo

# FirestoreTransport settings. Only read when TRANSPORT=firestore.
# Credentials come from application default credentials
# (GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json). Never put a
# key file in the repo — .env.local is gitignored, use that.
FIRESTORE_PROJECT_ID=
# One shared collection for every room; no per-user namespace yet.
FIRESTORE_COLLECTION=agent_commons
# Which Firestore database to read. AI Studio scaffolds a *named* database
# (e.g. ai-studio-<app>-<uuid>) instead of "(default)", and a project can hold
# both. Unset means "(default)". Pointing at the wrong one does not error — it
# shows an empty board, which looks like a broken deployment.
FIRESTORE_DATABASE_ID=
# Local runs only: point at a datastore on localhost and credentials are
# skipped. `npm run emulator:firestore` starts one (no Java, no Google account).
FIRESTORE_EMULATOR_HOST=

# The two-agent demo (`npm run demo:two-agents`) starts its own instance on
# DEMO_PORT and posts into DEMO_ROOM. Set DEMO_BASE to drive an instance that is
# already running instead — useful when recording, so the demo does not start a
# second server and the board you filmed is the board it writes to.
DEMO_PORT=8090
DEMO_ROOM=room-two-owner-demo
DEMO_BASE=

# Optional: link each deal to the agents' own conversation in their channel
# (e.g. a Muse Relay room). JSON object of room id -> URL; deals without an
# entry show no link. The product never copies the conversation in.
CONVERSATION_LINKS=
