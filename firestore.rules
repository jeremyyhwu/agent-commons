rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserOrgId() {
      let userSnap = get(/databases/$(database)/documents/users/$(request.auth.uid));
      if (!userSnap.exists()) return null;
      let orgId = userSnap.data.defaultOrgId;
      return orgId is string ? orgId : null;
    }

    function isOrgOwner(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid;
    }

    function isOrgMember(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isUserOrgParticipant(negotiationId) {
      let orgId = getUserOrgId();
      if (!(orgId is string)) return false;
      let negSnap = get(/databases/$(database)/documents/negotiations/$(negotiationId));
      if (!negSnap.exists()) return false;
      return orgId in negSnap.data.participantOrgIds;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');
    }

    // User profiles — strictly owner-isolated
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;  // listing users is never needed
      allow create: if isSignedIn() && request.auth.uid == userId
        && isValidId(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if isSignedIn() && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: false;

      match /interactions/{interactionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Verifiable result cards, rooms, and records (publicly readable for
    // third-party verification; writable only by authenticated owners)
    match /agent_commons/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Organizations
    match /organizations/{orgId} {
      allow get: if isSignedIn() && (isOrgOwner(orgId) || isOrgMember(orgId));
      allow list: if isSignedIn();  // client filters; server API enforces org scoping
      allow create: if isSignedIn()
        && isValidId(orgId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == orgId;
      allow update: if isSignedIn() && (isOrgOwner(orgId) || isOrgMember(orgId));
      allow delete: false;

      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          isOrgOwner(orgId) || request.auth.uid == memberUid
        );
      }
    }

    // Agents — org-scoped. Each agent's publicKey must match its agent_id.
    match /agents/{agentId} {
      allow get: if isSignedIn() && resource.data.ownerOrgId == getUserOrgId();
      allow list: if isSignedIn();  // client filters by ownerOrgId; server API enforces scoping
      allow create: if isSignedIn()
        && isValidId(agentId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.ownerOrgId == getUserOrgId()
        && request.resource.data.publicKey == agentId;  // agent_id IS the public key
      allow update: if isSignedIn()
        && resource.data.createdByUid == request.auth.uid
        && resource.data.ownerOrgId == getUserOrgId()
        && resource.data.status == "active";  // can't edit revoked agents
      allow delete: false;
    }

    // Negotiations & subcollections
    match /negotiations/{negotiationId} {
      allow get: if isSignedIn() && isUserOrgParticipant(negotiationId);
      allow list: if false;  // enforced server-side — listing requires org scoping
      allow create: if isSignedIn() && isValidId(negotiationId)
        && getUserOrgId() in request.resource.data.participantOrgIds;
      allow update: if isSignedIn() && isUserOrgParticipant(negotiationId);
      allow delete: false;

      match /proposals/{proposalId} {
        allow get, list: if isSignedIn() && isUserOrgParticipant(negotiationId);
        allow create: if isSignedIn() && isValidId(proposalId)
          && request.resource.data.proposerOrgId == getUserOrgId()
          && isUserOrgParticipant(negotiationId);
        // Updates (adding signatures) are allowed for participants, but only
        // on proposals that are still pending. Once accepted/rejected/withdrawn,
        // the proposal is immutable — enforced at the API layer.
        allow update: if isSignedIn() && isUserOrgParticipant(negotiationId)
          && resource.data.status == "pending";
        allow delete: false;
      }

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isUserOrgParticipant(negotiationId);
        allow create: if isSignedIn() && isValidId(messageId)
          && request.resource.data.senderOrgId == getUserOrgId()
          && isUserOrgParticipant(negotiationId);
        allow update, delete: if false;
      }

      match /agreements/{agreementId} {
        allow get, list: if isSignedIn() && isUserOrgParticipant(negotiationId);
        allow create: if isSignedIn() && isValidId(agreementId)
          && isUserOrgParticipant(negotiationId);
        allow update: if isSignedIn() && isUserOrgParticipant(negotiationId);
        allow delete: false;
      }

      match /interactions/{interactionId} {
        allow get, list: if isSignedIn() && isUserOrgParticipant(negotiationId);
        allow create, update: if isSignedIn() && isUserOrgParticipant(negotiationId);
        allow delete: false;
      }
    }
  }
}